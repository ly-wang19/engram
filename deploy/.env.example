# 复制为 deploy/.env 后，至少替换下面的强密钥。不要提交 deploy/.env。
# 同一租户可配置多个密钥用于无停机轮换：tenant:key-new,tenant:key-old
ENGRAM_API_KEYS=release-user:replace-with-at-least-32-random-characters
ENGRAM_PORT=8000
ENGRAM_MAX_REQUEST_BYTES=2097152
ENGRAM_MAX_HOT_USERS=64
ENGRAM_MAX_HOT_FACTS=10000
ENGRAM_EMBEDDER=hashing

# 按租户滑动窗口限流；0 = 关闭（默认）。超限返回 429 + Retry-After。
# 进程内实现：多副本下有效限额是 每分钟配额 × 副本数。
ENGRAM_RATE_LIMIT_PER_MIN=0

# Idempotency-Key 重放缓存的保留时长（秒）。同样是进程内的：多副本下重试若路由到
# 另一个副本仍会重跑。
ENGRAM_IDEMPOTENCY_TTL_S=86400

# 运行时签发/吊销租户密钥的管理面凭据。**故意留空**：不设置时 /v1/admin/keys 一律 403,
# 管理面根本不存在。只有确实需要不重启就增删租户时才设一个强随机串（与租户 key 不同）。
# ENGRAM_ADMIN_TOKEN=

# 可选模型后端；为空时保持离线规则抽取。
ENGRAM_LLM=
ENGRAM_ANSWERER=
